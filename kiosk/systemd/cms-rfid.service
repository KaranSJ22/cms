[Unit]
Description=CMS Kiosk RC522 RFID Virtual Keyboard Daemon
After=network.target

[Service]
Type=simple
User=canteenmitra
SupplementaryGroups=input spi gpio
WorkingDirectory=/home/canteenmitra/Project/kiosk/drivers
ExecStart=/home/canteenmitra/Project/venv/bin/python3 /home/canteenmitra/Project/kiosk/drivers/rfid_daemon.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cms-rfid

# Resource protection
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

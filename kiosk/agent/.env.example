# ============================================================
# CMS Kiosk Local Agent Environment Configuration
# ============================================================

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Kiosk Identity & Location
KIOSK_CODE=K1
CANTEEN_ID=1

# Local SQLite Storage Path
DB_PATH=./data/kiosk.db

# Central Server Connection
CENTRAL_API_BASE_URL=http://localhost:8080/api
CENTRAL_API_KEY=

# Background Synchronization Timers
HEARTBEAT_INTERVAL_MS=15000
SYNC_INTERVAL_MS=15000
SYNC_BATCH_SIZE=25

# CORS Allowed Origins (Chromium Kiosk Display)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5000
